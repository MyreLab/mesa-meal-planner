{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pointer to the current week",
  "type": "object",
  "required": ["schemaVersion", "week", "weeks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "week": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weeks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
  }
}
