{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Favourites rotation",
  "type": "object",
  "required": ["schemaVersion", "favorites"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "favorites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dish", "short", "protein", "slot", "totalMinutes", "premium", "lastCooked"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "dish": { "type": "string", "minLength": 1 },
          "short": { "type": "string", "minLength": 1 },
          "protein": { "type": "string", "enum": ["chicken", "fish", "beef", "turkey", "egg", "tofu", "beans"] },
          "slot": { "type": "string", "enum": ["any", "weekend"] },
          "totalMinutes": { "type": "integer", "minimum": 5 },
          "premium": { "type": "boolean" },
          "lastCooked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
