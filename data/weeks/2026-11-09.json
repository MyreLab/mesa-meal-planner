    {
      "key": "wknd",
      "date": "2026-11-08",
      "dish": "Slow-roasted chicken legs with carrots and parsnips",
      "short": "Roast chicken",
      "origin": "Sunday roast",
      "protein": "chicken",
      "proteinLabel": "Chicken legs",
      "wheat": "free",
      "minutes": {
        "hands": 15,
        "total": 75
      },
      "portions": 4,
      "feeds": "Dinner + Mon lunch",
      "headsUp": "Uses up the carrots and thyme from the fridge. The long roast is why this is a weekend dish. Pack half for Monday's lunch.",
      "ingredients": [
        {
          "item": "chicken-legs",
          "qty": "3 lb",
          "text": "chicken drumsticks and thighs"
        },
        {
          "item": "carrots",
          "qty": "3",
          "text": "carrots, cut in chunks"
        },
        {
          "item": "parsnips",
          "qty": "2",
          "text": "parsnips, cut in chunks"
        },
        {
          "item": "onions",
          "qty": "2",
          "text": "onions, in wedges"
        },
        {
          "item": "thyme",
          "qty": "6 sprigs",
          "text": "thyme"
        },
        {
          "item": "garlic",
          "qty": "1 head",
          "text": "garlic, halved across"
        },
        {
          "item": "lemons",
          "qty": "1",
          "text": "lemon, halved"
        },
        {
          "item": "olive-oil",
          "qty": "3 tbsp",
          "text": "olive oil"
        }
      ],
      "steps": [
        "Heat the oven to 375F. Toss the vegetables with half the oil, the thyme and salt on a large tray, tucking in the garlic halves.",
        "Rub the chicken with the remaining oil, salt and pepper and nestle it on top of the vegetables.",
        "Roast for 60 minutes, until the skin is deep golden and the vegetables are tender.",
        "Squeeze the roasted lemon over everything and rest for 10 minutes. Pack half for Monday."
      ],
      "side": {
        "name": "Garlicky wilted spinach",
        "ingredients": [
          {
            "item": "spinach",
            "qty": "10 oz",
            "text": "baby spinach"
          },
          {
            "item": "garlic",
            "qty": "2 cloves",
            "text": "garlic, sliced"
          },
          {
            "item": "olive-oil",
            "qty": "1 tbsp",
            "text": "olive oil"
          }
        ],
        "steps": [
          "Warm the oil with the garlic for 30 seconds, add the spinach by the handful and toss until just wilted, about 2 minutes. Season with salt."
        ]
      },
