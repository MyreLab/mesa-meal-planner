        },
        {
          "item": "olive-oil",
          "qty": "3 tbsp",
          "text": "olive oil"
        }
      ],
      "steps": [
        "Heat the oven to 425F. Whisk the lemon zest and juice, garlic, oregano, mustard and 2 tbsp of the oil with a large pinch of salt.",
        "Toss the thighs in the marinade and leave them for 10 minutes while the oven finishes heating.",
        "Spread on a lined tray and roast 22 to 25 minutes, until browned and cooked through (165F inside).",
        "Rest for 5 minutes and spoon over any tray juices. Pack half for Tuesday."
      ],
      "side": {
