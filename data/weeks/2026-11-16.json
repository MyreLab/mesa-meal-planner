          },
          {
            "item": "olive-oil",
            "qty": "1 tbsp",
            "text": "olive oil"
          }
        ],
        "steps": [
          "Toss the florets with the oil, chili flakes and salt, spread on a second tray and roast beside the chicken for the last 18 minutes, until the tips char. Finish with lemon."
