    {
      "key": "wknd",
      "date": "2026-11-15",
      "dish": "Smoky white bean and kale stew with a soft egg",
      "short": "Bean stew",
      "origin": "Tuscan-style",
      "protein": "beans",
      "proteinLabel": "White beans + egg",
      "wheat": "free",
      "minutes": {
        "hands": 20,
        "total": 55
      },
      "portions": 2,
      "feeds": "Dinner for two",
      "headsUp": "Clears out the end-of-week fridge: the kale, two carrots and a couple of celery stalks. A longer simmer, so it lives on the weekend.",
      "ingredients": [
        {
          "item": "kale",
          "qty": "1 bunch",
          "text": "kale, stems removed, leaves torn"
        },
        {
          "item": "carrots",
          "qty": "2",
          "text": "carrots, diced"
        },
        {
          "item": "celery",
          "qty": "2 stalks",
          "text": "celery, diced"
        },
        {
          "item": "onions",
          "qty": "1",
          "text": "onion, chopped"
        },
        {
          "item": "garlic",
          "qty": "4 cloves",
          "text": "garlic, sliced"
        },
        {
          "item": "white-beans",
          "qty": "2 cans",
          "text": "white beans, drained"
        },
        {
          "item": "broth",
          "qty": "3 cups",
          "text": "broth"
        },
        {
          "item": "tomato-paste",
          "qty": "2 tbsp",
          "text": "tomato paste"
        },
        {
          "item": "smoked-paprika",
          "qty": "1 tsp",
          "text": "smoked paprika"
        },
        {
          "item": "eggs",
          "qty": "2",
          "text": "eggs"
        },
        {
          "item": "olive-oil",
          "qty": "2 tbsp",
          "text": "olive oil"
        }
      ],
      "steps": [
        "Warm the oil in a wide pot over medium heat. Cook the onion, carrots and celery with a pinch of salt for 8 minutes, until soft.",
        "Stir in the garlic, tomato paste and paprika for a minute, then add the beans and broth. Simmer gently for 25 minutes, mashing a few beans against the side to thicken it.",
        "Add the kale and cook 5 more minutes. Taste and adjust the salt and pepper.",
        "Make two wells in the stew, crack in the eggs, cover and cook 3 to 4 minutes, until the whites are set."
      ],
      "side": {
        "name": "Crisp cucumber and radish salad",
        "ingredients": [
          {
            "item": "cucumbers",
            "qty": "2",
            "text": "cucumbers, sliced"
          },
          {
            "item": "radishes",
            "qty": "1 bunch",
            "text": "radishes, thinly sliced"
          },
          {
            "item": "lemons",
            "qty": "1",
            "text": "lemon, juiced"
          },
          {
            "item": "olive-oil",
            "qty": "1 tbsp",
            "text": "olive oil"
          }
        ],
        "steps": [
          "Toss the cucumber and radishes with the lemon juice, oil and a pinch of salt. Serve cold next to the stew."
        ]
      },
      "notes": [
        "Freezes well without the eggs."
      ],
      "source": {
        "label": "Original sample recipe",
